# Copiar a .env (local) y cargar las mismas variables en Vercel → Settings → Environment Variables
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=vcchile.cl,www.vcchile.cl,.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://vcchile.cl,https://www.vcchile.cl

# Postgres (ver POSTGRES.md). Local: URL directa. Vercel: URL "pooled" (host con -pooler).
# Sin esto se usa SQLite local.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/vc?sslmode=require

# Cloudflare R2
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key
R2_SECRET_ACCESS_KEY=tu_secret_key
R2_BUCKET=vc-media
R2_BUCKET_PRIVADO=vc-privado
R2_PUBLIC_DOMAIN=media.vcchile.cl

# Correo Outlook / Microsoft 365 (ver CORREO_OUTLOOK.md)
# CORREO_MODO: smtp | graph | (vacío = no envía, solo guarda en el admin)
CORREO_MODO=smtp
CORREO_REMITENTE=contacto@vcchile.cl
CORREO_DESTINO=svega@vcchile.cl,mcampos@vcchile.cl
# Solo modo smtp:
CORREO_CLAVE=clave_del_buzon
# Solo modo graph:
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
